# milliondollarfunnels.us — static Next.js export on Hostinger (Apache / LiteSpeed)
Options -Indexes
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# File types for 3D models, buffers, media and fonts (needed by the 3D sections on Apache/LiteSpeed)
<IfModule mod_mime.c>
  AddType application/octet-stream .buf .bin .dat
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType application/json .json .webmanifest
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg .svgz
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# One canonical host: https://milliondollarfunnels.us (no www, always HTTPS)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://milliondollarfunnels.us/$1 [L,R=301]

# URLs from the domain's earlier site that Google still crawls (SEO plan, 25 Nov 2026)
RewriteRule ^post/sales-funnels-for-coaches/?$ /services/sales-funnels-for-coaches [L,R=301]
RewriteRule ^post/build-sales-funnel-without-clickfunnels/?$ /blog/funnel-builder-vs-agency [L,R=301]
RewriteRule ^post/go-high-level-guide-pricing-features-setup/?$ /services/done-for-you-sales-funnels [L,R=301]
RewriteRule ^post/n8n-automation-guide/?$ /services/client-acquisition-system [L,R=301]
RewriteRule ^post/zapier-features-pricing-guide/?$ /services/client-acquisition-system [L,R=301]
RewriteRule ^post/website-visitor-tracking-tools/?$ /blog/speed-to-lead [L,R=301]
RewriteRule ^post/best-web-development-companies-florida/?$ /services/landing-page-design [L,R=301]
RewriteRule ^thank-you-page-page/?$ /thank-you [L,R=301]

# Old portfolio, tag, category, author and preview URLs are gone for good: 410
RewriteRule ^(projects|blog/tag|blog/category|blog/author|_preview)(/.*)?$ - [G,L]

# /index.html and /page.html -> clean URLs
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/([^?\s]+?)\.html[\s?] [NC]
RewriteCond %1 !^(404|lusion_standalone|downloads/.*)$
RewriteRule ^ /%1 [L,R=301]

# Trailing slash -> none (canonical URLs have no trailing slash)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [L,R=301]

# Clean URL -> exported .html file (e.g. /services -> services.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ /$1.html [L]

# Directory without its own page (e.g. /_next) -> 404 instead of a listing
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]
</IfModule>

# Caching: hashed build files forever, media for 30 days, HTML always fresh
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 0 seconds"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType application/octet-stream "access plus 30 days"
ExpiresByType model/gltf-binary "access plus 30 days"
ExpiresByType text/css "access plus 1 year"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/avif "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"
# Asset streaming for the embedded 3D scene (same as the previous cPanel config)
Header set Access-Control-Allow-Origin "*"
Header set Access-Control-Expose-Headers "Content-Length, Content-Range"
</IfModule>

# Never serve private files if they are ever uploaded by mistake
<FilesMatch "^(lead-config\.php|leads\.csv|\.env.*)$">
  Require all denied
</FilesMatch>
