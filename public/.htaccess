# ==============================================================================
# Million Dollar Funnels — Production cPanel / Apache / LiteSpeed Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MIME Types: 3D WebGL Models, Buffers, Shaders, Media & Fonts
#    (Fixes 404/403 errors on .buf, .glb, .webp, .mjs on live servers)
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/octet-stream .buf .bin .dat
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType application/json .json .webmanifest
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg .svgz
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType font/otf .otf
</IfModule>

# ------------------------------------------------------------------------------
# 2. CORS & Security Headers (Allow Iframe 3D Engine & Asset Streaming)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, HEAD"
  Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Range"
  Header set Access-Control-Expose-Headers "Content-Length, Content-Range"
  Header always unset X-Frame-Options
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ------------------------------------------------------------------------------
# 3. Gzip Compression for Fast Loading
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json font/woff font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# 4. Cache-Control for High Performance
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/octet-stream "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
</IfModule>

# ------------------------------------------------------------------------------
# 5. Clean URLs & SPA Rewrites (e.g. /work-proof, /cases/1-52m-case-study)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing file or directory directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Check if route.html exists (e.g. /work-proof -> /work-proof.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Check nested route (e.g. /cases/1-52m-case-study -> /cases/1-52m-case-study.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
  RewriteRule ^([^/]+)/([^/]+)/?$ $1/$2.html [L]

  # Check cases slug fallback
  RewriteCond %{DOCUMENT_ROOT}/cases/$1.html -f
  RewriteRule ^cases/([^/]+)/?$ cases/$1.html [L]

  # Fallback to index.html for client-side routing
  RewriteCond %{DOCUMENT_ROOT}/index.html -f
  RewriteRule ^ index.html [L]
</IfModule>
